#!/bin/bash
# Decide which scheduler host iceccd should use, based on where we are.
#
# Rules come from /etc/icecc/scheduler-switch.conf, one per line:
#   <scheduler> <condition>
# The first rule whose condition holds wins. With no match (or no config)
# ICECC_SCHEDULER_HOST is left empty, so iceccd finds the scheduler by
# broadcast. See scheduler-switch.conf.example for the conditions.
#
# The result is written to an env file that the iceccd.service drop-in reads.
# Invoked by:
#   - iceccd.service ExecStartPre (plain call, always exits 0)
#   - NetworkManager dispatcher with --restart-if-changed
# CONF and ENVFILE can be overridden from the environment for testing.
set -u

CONF=${CONF:-/etc/icecc/scheduler-switch.conf}
ENVFILE=${ENVFILE:-/run/iceccd-scheduler.env}
SCHEDULER_PORT=8765
TAG=icecc-pick-scheduler

ip4_to_int() {
    local IFS=.
    set -- $1
    echo $(( ($1 << 24) | ($2 << 16) | ($3 << 8) | $4 ))
}

# True if this machine has a global IPv4 address inside CIDR ("a.b.c.d/n").
in_subnet() {
    local net bits mask addr
    if ! [[ $1 =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$ ]]; then
        logger -t "$TAG" "$CONF:$n: invalid subnet '$1', rule skipped"
        return 1
    fi
    net=$(ip4_to_int "${1%/*}")
    bits=${1#*/}
    mask=$(( bits == 0 ? 0 : (0xffffffff << (32 - bits)) & 0xffffffff ))
    for addr in $(ip -4 -o addr show scope global | awk '{print $4}'); do
        addr=$(ip4_to_int "${addr%/*}")
        (( (addr & mask) == (net & mask) )) && return 0
    done
    return 1
}

# True if HOST[:PORT] accepts a TCP connection within 2 seconds.
reachable() {
    local host=${1%:*} port=$SCHEDULER_PORT
    [[ $1 == *:* ]] && port=${1##*:}
    timeout 2 bash -c 'exec 3<>"/dev/tcp/$0/$1"' "$host" "$port" 2>/dev/null
}

new=""
why="no rule matched"
n=0
if [ -r "$CONF" ]; then
    while read -r sched cond arg _; do
        n=$((n + 1))
        case "$sched" in ''|'#'*) continue ;; esac
        case "$cond" in
            subnet)    in_subnet "$arg" ;;
            reachable) target=${arg:-$sched}
                       if [ "$target" = broadcast ]; then
                           logger -t "$TAG" "$CONF:$n: 'broadcast reachable' needs a host, rule skipped"
                           false
                       else
                           reachable "$target"
                       fi ;;
            always)    true ;;
            *)         logger -t "$TAG" "$CONF:$n: unknown condition '$cond', rule skipped"
                       false ;;
        esac || continue
        [ "$sched" = broadcast ] || new=$sched
        why="$CONF:$n: $cond${arg:+ $arg}"
        break
    done < "$CONF"
else
    why="no $CONF"
fi

old=""
[ -r "$ENVFILE" ] && old=$(sed -n 's/^ICECC_SCHEDULER_HOST=//p' "$ENVFILE")

changed=0
if [ ! -e "$ENVFILE" ] || [ "$new" != "$old" ]; then
    printf 'ICECC_SCHEDULER_HOST=%s\n' "$new" > "$ENVFILE"
    logger -t "$TAG" "scheduler host set to '${new:-<broadcast>}' ($why)"
    changed=1
fi

if [ "${1:-}" = "--restart-if-changed" ] && [ "$changed" = 1 ]; then
    # try-restart: only restart if iceccd is actually running
    systemctl --no-block try-restart iceccd.service
fi
exit 0
